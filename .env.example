# 不填写模型配置也可使用本地规则模式。
PORT=4317
HOST=127.0.0.1
# DATA_DIR=data
# 本地阶段间隔仅用于观察流程，可改为 0 以最快速度执行。
WORKFLOW_STEP_DELAY_MS=350

# 可选：兼容 Chat Completions 的模型服务。
# 只填写服务根路径（通常以 /v1 结尾），不要填写 /chat/completions。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=1
# DeepSeek 支持 enabled / disabled；其他兼容服务请按其文档设置或留空。
LLM_THINKING=disabled
LLM_MAX_TOKENS=16384
LLM_TIMEOUT_MS=120000

# 可选：仅受控编码试验使用。配置现代原生 Codex CLI 的绝对路径。
# 该程序必须支持 Windows MXC 权限配置，预检不通过时拒绝执行。
# EXECUTION_SANDBOX_EXE=
# EXECUTION_OUTPUT_DIR=output/executions

# 可选团队账号模式。默认0保持本机单人用法；设为1并重启后，首次访问设置负责人。
# 负责人添加评审者/观察者。密码和登录令牌仅保存在本机私有账号库，不进入模型或交付包。
TASKFLOW_TEAM_MODE=0
