{
  "name": "taskflow-requirements-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "将软件需求文档转换为规格、开发任务和可审阅的编排流程",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "model:check": "node scripts/check-model.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "execution:check": "node scripts/check-executor.mjs",
    "web:check": "node scripts/check-web-executor.mjs"
  },
  "dependencies": {
    "playwright-core": "1.65.0"
  }
}
